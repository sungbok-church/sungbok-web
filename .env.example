# 로컬 개발용. 복사해서 .env.local 로 저장. (.env.local 은 커밋되지 않음)
# 유튜브 API 키(서버 전용, NEXT_PUBLIC_ 없음)는 각자 Google Cloud 콘솔에서 발급(무료). 운영 키는 Vercel 에만 있음.
YOUTUBE_API_KEY=
# 성복교회 채널 ID (공개 값, 코드 fallback 과 동일)
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=UClz4pOT6Kmuy8MvR3cyHPjA
# 관리자(/admin)용 Supabase. 로컬 개발은 `pnpm db:start` 가 알려 주는 로컬 주소·키를 넣는다(운영 값을 넣지 않는다).
# 프로젝트 주소(API URL)
NEXT_PUBLIC_SUPABASE_URL=
# 공개용 키(publishable key). 만능 키(secret key)는 여기에 넣지 않는다
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용 Supabase 키(만능 키 — RLS 를 건너뛴다). 관리자의 계정 만들기 · 비밀번호 초기화에만 쓴다.
# 로컬은 `pnpm supabase status -o env` 의 SECRET_KEY. 운영 값은 GitHub Secret → Sync env to Vercel.
SUPABASE_SECRET_KEY=
